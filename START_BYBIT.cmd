@echo off
cd /d "%~dp0"
where py >nul 2>nul
if errorlevel 1 goto TRY_PYTHON
py -3 -S scripts\collect_bybit_public_v2.py
goto DONE
:TRY_PYTHON
where python >nul 2>nul
if errorlevel 1 goto NO_PYTHON
python -S scripts\collect_bybit_public_v2.py
goto DONE
:NO_PYTHON
echo Python 3 is required. Install from python.org and run this file again.
:DONE
echo.
echo Keep the generated bybit_measurements ZIP and upload it in the chat.
pause
