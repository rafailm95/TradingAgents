@echo off
cd /d "%~dp0"
echo Bybit public historical data - no API key or account required.
echo Keep this window open. Re-run this file to resume verified pages.
where py >nul 2>nul
if errorlevel 1 goto TRY_PYTHON
py -3 -S scripts\collect_bybit_history.py
goto DONE
:TRY_PYTHON
where python >nul 2>nul
if errorlevel 1 goto NO_PYTHON
python -S scripts\collect_bybit_history.py
goto DONE
:NO_PYTHON
echo Python 3 is required. Install from python.org and run this file again.
:DONE
echo.
echo Upload the generated bybit_history_013.zip in the chat, including if it reports an error.
pause
